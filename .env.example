# ==============================================================================
# Variables de entorno del Backend (Spring Boot - psycho-form/psychoform)
# Copia este archivo a .env o ejecuta: ./env.sh init
# ==============================================================================

# Base de datos PostgreSQL (por defecto apunta a Supabase local)
BFA_DB_URL=jdbc:postgresql://127.0.0.1:54322/postgres
BFA_DB_USERNAME=postgres
BFA_DB_PASSWORD=postgres

# Secreto para firma de tokens JWT (cambia esto en producción)
BFA_JWT_SECRET=un_secreto_temporal_muy_largo_para_desarrollo_local

# Almacenamiento compatible con S3 (por defecto Supabase Storage local)
BFA_STORAGE_S3_ENDPOINT=http://127.0.0.1:54321/storage/v1/s3
BFA_STORAGE_S3_REGION=local
BFA_STORAGE_S3_BUCKET=images
BFA_STORAGE_S3_ACCESS_KEY=
BFA_STORAGE_S3_SECRET_KEY=
BFA_STORAGE_S3_PATH_STYLE=true
